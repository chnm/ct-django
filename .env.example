# Django
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1:8000
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connectingthreads
DB_USER=connectingthreads
DB_PASS=password

# Wagtail
WAGTAIL_BASE_URL=http://localhost:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Object storage (leave disabled to use local mediafiles/)
OBJ_STORAGE=False
OBJ_STORAGE_ACCESS_KEY_ID=
OBJ_STORAGE_SECRET_ACCESS_KEY=
OBJ_STORAGE_BUCKET_NAME=
OBJ_STORAGE_ENDPOINT_URL=

# Museum integrations
COOPER_HEWITT_API_KEY=
GEOCODING_USER_AGENT=ConnectingThreads/1.0
